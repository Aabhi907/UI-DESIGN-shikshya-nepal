+  ok(response.status === 503, `${file}: expected 503 while closed, got ${response.status}`)
+  ok(response.body?.error === COMMUNITY_CLOSED_MESSAGE, `${file}: expected the closed message, got ${JSON.stringify(response.body)}`)
+}
