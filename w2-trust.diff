+      let content
+      try { content = fs.readFileSync(file, 'utf8') } catch { continue }
+      if (/@sikshyanepal\.com/i.test(content)) offenders.push(file)
+    }
+  }
+  ok(offenders.length === 0, `Dead @sikshyanepal.com address(es) found: ${offenders.join(', ')}`)
+}
